# ============ 应用 ============
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
# CORS 允许的来源（逗号分隔，如 https://admin.example.com）。留空 = 仅同源访问
CORS_ORIGINS=

# ============ 数据库 (PostgreSQL + pgvector, 同步 psycopg) ============
# docker-compose 中服务名为 db；本地直连时改为 localhost
DATABASE_URL=postgresql+psycopg://kb_user:kb_password@db:5432/kb_db

# ============ 管理员 JWT ============
JWT_SECRET=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 首次初始化时创建的超级管理员（请在上线后修改）
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=Admin@123456

# ============ 飞书（长连接模式） ============
FEISHU_APP_ID=YOUR_FEISHU_APP_ID
FEISHU_APP_SECRET=YOUR_FEISHU_APP_SECRET
# 机器人名称，用于从消息中剥离 @提及；留空则自动按事件判断
FEISHU_BOT_NAME=

# ============ 通义 Embedding（DashScope） ============
DASHSCOPE_API_KEY=YOUR_DASHSCOPE_API_KEY
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024

# ============ DeepSeek（生成） ============
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ============ RAG 参数 ============
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.30
RAG_RETRIEVE_MODE=mix          # vector | keyword | mix
RAG_QUERY_REWRITE=0            # 1=先 LLM 改写查询再检索（提升召回，多一次调用）
RRF_K=60
BM25_WEIGHT=0.30
CHUNK_SIZE=512
CHUNK_OVERLAP=128
MAX_UPLOAD_MB=20               # 上传文档大小上限（MB）

# 价格（元/千 token），用于用量估算，可按实际调整
PRICE_EMBEDDING_PER_1K=0.0007
PRICE_INPUT_PER_1K=0.001
PRICE_OUTPUT_PER_1K=0.002
